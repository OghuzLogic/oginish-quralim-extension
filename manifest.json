{
  "manifest_version": 3,
  "name": "ئۆگىنىش قۇرالىم",
  "version": "1.0.0",
  "description": "JSON سۇئال-جاۋابلار ئارقىلىق كىتاب ۋە بىلىملەرنى تەرتىپلىك ئۆگىنىش، بروسىر ئېچىلغاندا ئەسكەرتىش ئېلىش ۋە زىكىر قىلىش ئۈچۈن مەخپىيەتلىككە سادىق قىستۇرما.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ئۆگىنىش قۇرالىم",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none';"
  }
}
